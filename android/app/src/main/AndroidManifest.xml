<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 权限：INTERNET/录音与原 APK 一致；图片/拍照按用户要求增加运行时权限 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- 相册（App 内网格）：现在真的会查 MediaStore 列表，所以必须声明读媒体权限。
         - Android 13+：READ_MEDIA_IMAGES；
         - Android 14+：再加 READ_MEDIA_VISUAL_USER_SELECTED，系统才会给
           「全部允许 / 选择照片 / 不允许」三选，用户只给部分照片时列表就只
           返回那几张（界面上会提示"仅显示已授权的照片"）。
         - 只读图片，不读视频/音频，所以不声明 READ_MEDIA_VIDEO / AUDIO。
         为什么终于需要它：系统选图 Intent（ACTION_GET_CONTENT 等）在国产 ROM
         上会被文件管理器抢走，改成 App 内相册后必须自己查 MediaStore。 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
    <!-- Android 12 及以下（API ≤ 32）用旧的分区存储权限；image_picker 拍完照
         写缓存时在个别 ROM 上仍会查这一条，保留但封顶到 32。 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <!-- 应用内更新：允许拉起系统安装器安装下载好的 APK（Android 8.0+ 还需用户手动授权）。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- L3：通知权限（Android 13+ 运行时申请）。M1 只做到「明示可续跑」，
         这一条为将来接前台服务/进度通知预留；现在声明不会弹任何系统框
         （未运行时申请 = 不打扰）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- M1：唤醒锁权限。当前代码没有 PARTIAL_WAKE_LOCK 调用，只是为将来
         后台任务加 wakelock_plus / 前台服务铺路，不新增依赖也不影响耗电。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- L1：相机/麦克风都不是必需硬件 —— 不声明 required=false 时应用商店会把
         「无摄像头平板」「电子墨水设备」直接过滤掉。 -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <!-- package visibility：targetSdk 36 在 Android 11+ 按 `<queries>` 过滤可见性；
         下面这些 intent 没声明的话 resolveActivity() 会返回 null。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT"/>
            <data android:mimeType="*/*"/>
        </intent>
        <!-- 图库选图：Android 13+ 系统 Photo Picker -->
        <intent>
            <action android:name="android.intent.action.PICK_IMAGES"/>
            <data android:mimeType="image/*"/>
        </intent>
        <!-- 图库选图：厂商图库（华为等没有 Photo Picker 的机型走这条） -->
        <intent>
            <action android:name="android.intent.action.PICK"/>
            <data android:scheme="content"/>
            <data android:mimeType="image/*"/>
        </intent>
        <!-- 图库探测：用 GET_CONTENT(image/*) 找"能看图"的应用，再把文件管理器扣掉 -->
        <intent>
            <action android:name="android.intent.action.GET_CONTENT"/>
            <data android:mimeType="image/*"/>
        </intent>
        <!-- 图库探测：OPEN_DOCUMENT(image/*) 的响应者就是"文件管理器/文档选择器"，
             拿它当黑名单，保证「从相册选择」永远不会落到 DocumentsUI / 文件管理 -->
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT"/>
            <data android:mimeType="image/*"/>
        </intent>
        <!-- 应用内更新：系统安装器（Android 7+ 走 FileProvider 的 content://） -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="content"/>
            <data android:mimeType="application/vnd.android.package-archive"/>
        </intent>
        <!-- L3/预测性返回：系统「返回手势」设置页（部分 ROM 需要能跳过去） -->
        <intent>
            <action android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES"/>
            <data android:scheme="package"/>
        </intent>
    </queries>

    <!-- requestLegacyExternalStorage：只在 Android 10（API 29）生效，11+ 被忽略。
         相册网格拿 MediaStore 的 DATA 列当本地路径直接用 `File` 读，而 Android 10
         的分区存储默认会把"其他 App 的媒体文件路径"挡掉（EACCES）；打开这个开关
         让 29 上退回旧行为，31+ 本来就用 READ_MEDIA_* + 路径直读，不受影响。 -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:requestLegacyExternalStorage="true"
        android:enableOnBackInvokedCallback="true">
        <!-- L2：allowBackup=false —— 换机助手/云备份只会搬走 DB 而搬不走附件，
             恢复后会出现「会话在、图片全丢」的假完整状态，所以干脆不参与备份
             （导出走「存到手机」的 ZIP，是完整的）。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- 启动时（Flutter UI 初始化前）的窗口主题，见 res/values/styles.xml -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 应用内更新：把下载到 files/updates（或 cache）的 APK 以 content:// 交给系统安装器。
             authorities 必须与 MainActivity.kt 里 FileProvider.getUriForFile 的第二个参数一致。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
</manifest>
